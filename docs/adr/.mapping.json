{
  "$schema": "https://raw.githubusercontent.com/haandol/alps-writer-plugins/main/plugins/adr-writer/templates/adr/mapping.schema.json",
  "categories": {
    "capture": {
      "feature": "회의 오디오 캡처",
      "subdomainType": "core",
      "adrs": [
        {
          "path": "docs/adr/capture/0001-system-audio-process-tap.md",
          "status": "Accepted (2026-08-21)",
          "summary": "시스템 출력은 Core Audio Process Tap으로 받아 화면 녹화 권한을 요구하지 않는다"
        },
        {
          "path": "docs/adr/capture/0002-silent-capture-detection.md",
          "status": "Accepted (2026-08-21)",
          "summary": "캡처 API가 권한 없이도 성공을 반환하므로 성공 여부를 버퍼 진폭으로 판정한다"
        },
        {
          "path": "docs/adr/capture/0003-per-source-failure-isolation.md",
          "status": "Accepted (2026-08-21)",
          "summary": "두 소스를 독립적으로 유지하고 설정 가능한 로컬 단축키(기본 ⌘Y) 또는 버튼으로 마이크만 음소거한다"
        },
        {
          "path": "docs/adr/capture/0004-input-level-diagnostics.md",
          "status": "Accepted (2026-08-21)",
          "summary": "레벨을 미터·무음판정·발화평균 세 값으로 나눠 추적하고 원본에 게인 보정을 하지 않는다"
        },
        {
          "path": "docs/adr/capture/0005-capture-device-change-follow.md",
          "status": "Accepted (2026-08-21)",
          "summary": "캡처 장치는 시스템 기본을 따라가고 사용자가 고르면 그 장치에 고정한다 (세션은 끊지 않음)"
        }
      ],
      "dependsOn": []
    },
    "transcription": {
      "feature": "온디바이스 전사와 화자 구분",
      "subdomainType": "core",
      "adrs": [
        {
          "path": "docs/adr/transcription/0001-source-based-speaker-attribution.md",
          "status": "Proposed",
          "summary": "소스별 독립 분석기로 화자를 확정하고 나 vs 상대방 전원 2분리를 상한으로 수용한다"
        },
        {
          "path": "docs/adr/transcription/0002-token-level-language-arbitration.md",
          "status": "Proposed",
          "summary": "다국어 결과를 토큰 단위 구역별 지속시간 가중 신뢰도로 중재한다"
        },
        {
          "path": "docs/adr/transcription/0003-model-provisioning-gate.md",
          "status": "Accepted (2026-08-21)",
          "summary": "필수 English 모델은 앱 시작 시 자동 설치하고 한국어는 설정에서 관리하며 설치 요청은 예약·진행률 취소와 분리하고 최종 설치 목록으로 성공을 판정한다"
        },
        {
          "path": "docs/adr/transcription/0004-in-session-language-switch.md",
          "status": "Accepted (2026-08-21)",
          "summary": "설치된 회의 언어만 녹취 중 전환하고 캡처·회의 음성·회의록은 끊지 않으며 English는 필수 기본 모델로 유지한다"
        }
      ],
      "dependsOn": [
        "capture"
      ]
    },
    "diarization": {
      "feature": "회의 후 원격 화자 분리",
      "subdomainType": "supporting",
      "adrs": [
        {
          "path": "docs/adr/diarization/0001-s3-batch-diarization.md",
          "status": "Accepted (2026-08-20)",
          "summary": "회의 후 화자 분리는 승인된 S3 배치로 실행하고 익명 화자를 로컬 발화 근거로 실제 참석자와 매칭하며 미확정 화자는 Unknown N으로 표시한다"
        }
      ],
      "dependsOn": []
    },
    "session": {
      "feature": "녹취 세션 경계와 화면 접근",
      "subdomainType": "core",
      "adrs": [
        {
          "path": "docs/adr/session/0001-session-boundary-control.md",
          "status": "Proposed",
          "summary": "캡처를 끊지 않고 세션 경계를 끊어 회의 단위로 산출물을 나눈다"
        },
        {
          "path": "docs/adr/session/0002-global-hotkey-floating-window.md",
          "status": "Proposed",
          "summary": "전역 단축키(기본 ⌥⌘S, 변경 가능)로 포커스를 잃어도 닫히지 않는 전사 창을 띄운다"
        },
        {
          "path": "docs/adr/session/0003-settings-surface-separation.md",
          "status": "Proposed",
          "summary": "회의 중 보는 것만 전사 화면에 남기고 설정은 별도 창으로 분리한다 (단축키 기본 ⌘, 변경 가능)"
        },
        {
          "path": "docs/adr/session/0004-user-initiated-update-check.md",
          "status": "Proposed",
          "summary": "버전 확인은 사용자가 누를 때만 조회하고 앱이 내려받지는 않는다 (자동 조회 없음)"
        },
        {
          "path": "docs/adr/session/0005-interface-language.md",
          "status": "Proposed",
          "summary": "화면 언어를 한국어·영어에서 고르게 하고(기본은 시스템 언어 추종) 산출물 화자 라벨은 영어로 고정한다"
        }
      ],
      "dependsOn": [
        "capture",
        "transcription",
        "archive"
      ]
    },
    "archive": {
      "feature": "회의록과 원본 오디오 보관",
      "subdomainType": "supporting",
      "adrs": [
        {
          "path": "docs/adr/archive/0001-transcript-durability.md",
          "status": "Proposed",
          "summary": "확정 발화를 즉시 append하고 읽기용 회의록은 종료 시 생성하며 마무리를 시간 제한한다"
        },
        {
          "path": "docs/adr/archive/0002-original-audio-format.md",
          "status": "Proposed",
          "summary": "회의 중 두 캡처를 공통 시간축의 모노 meeting.m4a 하나로 합성하고 별도 소스 파일은 만들지 않는다"
        },
        {
          "path": "docs/adr/archive/0003-session-output-discoverability.md",
          "status": "Proposed",
          "summary": "저장 위치를 항상 표시하고(녹취 중·직전·루트) 종료 시 폴더를 자동으로 연다 (기본 켬, 세션 경계에서는 열지 않음)"
        },
        {
          "path": "docs/adr/archive/0004-transcript-root-location.md",
          "status": "Proposed",
          "summary": "산출물 저장 루트를 사용자가 고를 수 있게 하고, 쓸 수 없으면 기본 위치로 되돌려 녹취를 진행한다 (기존 산출물은 옮기지 않음)"
        }
      ],
      "dependsOn": [
        "transcription"
      ]
    }
  }
}
